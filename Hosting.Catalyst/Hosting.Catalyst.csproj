<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>Diagrid</Authors>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Diagrid.Aspire.Hosting.Catalyst</RootNamespace>
        <PackageId>Diagrid.Aspire.Hosting.Catalyst</PackageId>
        <AssemblyName>Diagrid.Aspire.Hosting.Catalyst</AssemblyName>
        <IsPackable>true</IsPackable>
        <PackageIcon>/catalyst-logo.png</PackageIcon>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/diagrid-labs/catalyst-aspire</RepositoryUrl>
        <!--
            Without an explicit Description, MSBuild packs the literal placeholder "Package Description".
            Every version published so far (0.0.1 through 1.0.0) carries it on nuget.org.
        -->
        <Description>.NET Aspire hosting integration for Diagrid Catalyst. Declare a Catalyst project, apps, agents, managed KV stores and pub/sub brokers, components and subscriptions in your AppHost, and the integration provisions them through the Diagrid CLI when you run it. Built so that moving a Dapr OSS service to Catalyst needs no change to the service's own code.</Description>
        <PackageProjectUrl>https://github.com/diagrid-labs/catalyst-aspire</PackageProjectUrl>
        <PackageTags>aspire;dapr;diagrid;catalyst;distributed-applications;workflow;pubsub;statestore</PackageTags>
        <!--
            SPDX expression rather than PackageLicenseFile: nuget.org renders it as a known licence on the
            package page instead of an attachment to open. The LICENSE file at the repo root is what GitHub
            reads; the two must stay in agreement.
        -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <Copyright>Copyright (c) 2026 Diagrid</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <!-- todo: Is this the package we should be depending on? -->
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Hosting.Catalyst.IntegrationTests" />
        <InternalsVisibleTo Include="Hosting.Catalyst.Tests" />
        <InternalsVisibleTo Include="Hosting.Catalyst.SmokeTests" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Logo\*.txt" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="../catalyst-logo.png" Link="/catalyst-logo.png" Pack="true" PackagePath="/" >
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="../readme.md" Pack="true" PackagePath="/">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
